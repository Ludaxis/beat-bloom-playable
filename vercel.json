{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/",
      "destination": "/review/index.html"
    },
    {
      "source": "/play",
      "destination": "/review/shared.html"
    },
    {
      "source": "/play/:id",
      "destination": "/review/shared.html"
    },
    {
      "source": "/dist/:path*",
      "destination": "/:path*"
    }
  ],
  "functions": {
    "api/export.js": {
      "maxDuration": 60,
      "includeFiles": "{assets/{native/**,encoded-audio/**,music/*.m4a,music/encoded/**,music/catalog.json,music/performers/**,*.mp3,*.webp,*.ttf,provenance.json},src/**,scripts/**,content/music/*.json,THIRD_PARTY_NOTICES.txt,node_modules/{pixi.js,@pixi,earcut,eventemitter3,gifuct-js,ismobilejs,parse-svg-path,tiny-lru,js-binary-schema-parser,@xmldom}/**}",
      "excludeFiles": "assets/music/fallback/**"
    },
    "api/share.js": {
      "maxDuration": 30,
      "includeFiles": "{assets/native/*.json,src/**,scripts/**,THIRD_PARTY_NOTICES.txt,node_modules/{pixi.js,@pixi,earcut,eventemitter3,gifuct-js,ismobilejs,parse-svg-path,tiny-lru,js-binary-schema-parser,@xmldom}/**}",
      "excludeFiles": "assets/music/**"
    }
  }
}
